# Copy this file to "secrets.yaml" (next to the YAML you compile, or in your
# ESPHome config folder) and fill in YOUR values. secrets.yaml is git-ignored:
# never commit it.
#
# Generate an API encryption key (32 random bytes, base64) with:
#   openssl rand -base64 32

# -- shared ------------------------------------------------------------------
wifi_ssid: "YourWiFi"
wifi_password: "your-wifi-password"
ap_password: "fallback-hotspot-password"      # 8+ characters

# -- examples/heatpump.yaml ---------------------------------------------------
api_key_heatpump: "REPLACE-WITH-openssl-rand-base64-32"
